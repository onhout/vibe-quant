# Copy to .env (gitignored) and fill in real values for your environment.
# Every variable below is read directly via os.getenv(). Unset vars use the
# defaults shown in the inline comments.

# --- Research / Reddit -------------------------------------------------------
# Reddit killed unauthenticated `.json` access in 2026-05 (see
# docs/reddit-access-research.md); a plain request now 403s. The durable fix is
# OAuth (pending approval). REDDIT_USER_AGENT is still used by both paths.
# Format: '<platform>:<app-id>:<version> (by /u/<your-username>)'
REDDIT_USER_AGENT=vibe-quant-research:0.1 (by /u/your-username)

# Comma-separated subreddits to scrape. Default: algotrading
REDDIT_SUBREDDITS=algotrading,quant,wallstreetbets

# Stopgap until OAuth: glance-style browser-challenge fetch (TLS-fingerprint
# impersonation + JS-challenge solve). ToS-grey, low-volume only; off by
# default. Set to 1/true/yes/on to enable.
REDDIT_USE_CHALLENGE=0

# --- Paper trading (Binance) -------------------------------------------------
# Testnet sessions (the default) read ONLY these:
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
# LIVE (real funds) sessions read ONLY these, and additionally need
# confirm_live=true via the API or `--live` on the paper CLI:
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Live execution (Ethereal) -----------------------------------------------
ETHEREAL_PRIVATE_KEY=

# --- Alerts (Telegram) -------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- DSL plugins -------------------------------------------------------------
# Strict mode: any plugin load failure aborts startup (default: lenient).
VQ_PLUGINS_STRICT=
# Extra paths (colon-separated) to scan for indicator plugins.
VQ_PLUGIN_PATH=

# --- Research LLM -------------------------------------------------------------
# Default: the `claude` CLI. VQ_EXTRACTOR=openai sends extraction, indicator
# codegen and the trader_methods source to an OpenAI-compatible endpoint.
VQ_EXTRACTOR=
VQ_OPENAI_BASE_URL=
# Default gpt-5.6-sol; VQ_OPENAI_API_KEY only if the endpoint needs one.
VQ_OPENAI_MODEL=
VQ_OPENAI_API_KEY=
# Market the extraction prompt targets: crypto_perps (default) or us_stocks
# (adds daily bars, options plays become stock signals, lists indicator params).
VQ_RESEARCH_MARKET=

# --- Research sources ----------------------------------------------------------
# arctic_shift: subreddits read through the Arctic Shift archive (default wallstreetbets).
VQ_ARCTIC_SUBREDDITS=
# wsb_archive: local WallStreetBets title archive (default ~/trading/data/cache/lab/wsb.db).
VQ_WSB_ARCHIVE_DB=
# trader_methods: comma-separated "Trader: method" list (default: 10 well-known methods).
VQ_TRADER_METHODS=

# --- Auto-screen and research loop ---------------------------------------------
# Symbols/lookback each parsed extraction is screened on (default BTCUSDT, 180 days).
VQ_AUTO_SCREEN_SYMBOLS=
VQ_AUTO_SCREEN_LOOKBACK_DAYS=
# Backend the research loop launches discovery/validation/paper through (default http://127.0.0.1:8000).
VQ_API_URL=
