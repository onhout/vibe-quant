[
  {
    "name": "rsi_mean_reversion",
    "description": "Buy oversold (RSI < 30), sell overbought (RSI > 70). Simple mean reversion with ATR trailing stops.",
    "strategy_type": "mean_reversion",
    "dsl_config": {
      "name": "rsi_mean_reversion",
      "description": "RSI mean reversion: buy oversold, sell overbought with ATR trailing stops",
      "version": 1,
      "timeframe": "1h",
      "additional_timeframes": [],
      "indicators": {
        "rsi": {
          "type": "RSI",
          "period": 14,
          "source": "close"
        },
        "ema_filter": {
          "type": "EMA",
          "period": 50,
          "source": "close"
        },
        "atr": {
          "type": "ATR",
          "period": 14
        }
      },
      "entry_conditions": {
        "long": ["rsi < 30", "close > ema_filter"],
        "short": ["rsi > 70", "close < ema_filter"]
      },
      "exit_conditions": {
        "long": ["rsi > 60"],
        "short": ["rsi < 40"]
      },
      "time_filters": {
        "allowed_sessions": [],
        "blocked_days": ["Saturday", "Sunday"],
        "avoid_around_funding": {
          "enabled": true,
          "minutes_before": 5,
          "minutes_after": 5
        }
      },
      "stop_loss": {
        "type": "atr_trailing",
        "atr_multiplier": 2.0,
        "indicator": "atr"
      },
      "take_profit": {
        "type": "risk_reward",
        "risk_reward_ratio": 2.0
      },
      "position_management": {
        "scale_in": {
          "enabled": false
        },
        "partial_exit": {
          "enabled": false
        }
      },
      "sweep": {
        "rsi.period": [10, 14, 21],
        "ema_filter.period": [20, 50, 100]
      }
    }
  },
  {
    "name": "rsi_divergence",
    "description": "Detects when price makes new lows but RSI makes higher lows (bullish divergence) using EMA trend filter.",
    "strategy_type": "momentum",
    "dsl_config": {
      "name": "rsi_divergence",
      "description": "RSI divergence detector with EMA trend filter and ATR stops",
      "version": 1,
      "timeframe": "15m",
      "additional_timeframes": ["1h"],
      "indicators": {
        "rsi": {
          "type": "RSI",
          "period": 14,
          "source": "close"
        },
        "ema_fast": {
          "type": "EMA",
          "period": 9,
          "source": "close"
        },
        "ema_slow": {
          "type": "EMA",
          "period": 21,
          "source": "close"
        },
        "ema_trend": {
          "type": "EMA",
          "period": 50,
          "source": "close",
          "timeframe": "1h"
        },
        "atr": {
          "type": "ATR",
          "period": 14
        }
      },
      "entry_conditions": {
        "long": ["rsi < 35", "close > ema_trend", "ema_fast > ema_slow"],
        "short": ["rsi > 65", "close < ema_trend", "ema_fast < ema_slow"]
      },
      "exit_conditions": {
        "long": ["rsi > 65"],
        "short": ["rsi < 35"]
      },
      "time_filters": {
        "allowed_sessions": [],
        "blocked_days": ["Saturday", "Sunday"],
        "avoid_around_funding": {
          "enabled": true,
          "minutes_before": 5,
          "minutes_after": 5
        }
      },
      "stop_loss": {
        "type": "atr_trailing",
        "atr_multiplier": 2.5,
        "indicator": "atr"
      },
      "take_profit": {
        "type": "risk_reward",
        "risk_reward_ratio": 2.5
      },
      "position_management": {
        "scale_in": {
          "enabled": false
        },
        "partial_exit": {
          "enabled": false
        }
      },
      "sweep": {
        "rsi.period": [10, 14, 21],
        "ema_fast.period": [5, 9, 13],
        "ema_slow.period": [15, 21, 30]
      }
    }
  },
  {
    "name": "macd_crossover",
    "description": "Enter when MACD crosses signal line with EMA trend confirmation. Classic momentum strategy with session filters.",
    "strategy_type": "momentum",
    "dsl_config": {
      "name": "macd_crossover",
      "description": "MACD signal line crossover with EMA trend filter and session restrictions",
      "version": 1,
      "timeframe": "15m",
      "additional_timeframes": [],
      "indicators": {
        "macd": {
          "type": "MACD",
          "fast_period": 12,
          "slow_period": 26,
          "signal_period": 9,
          "source": "close"
        },
        "ema_fast": {
          "type": "EMA",
          "period": 9,
          "source": "close"
        },
        "ema_slow": {
          "type": "EMA",
          "period": 21,
          "source": "close"
        },
        "atr": {
          "type": "ATR",
          "period": 14
        }
      },
      "entry_conditions": {
        "long": ["ema_fast crosses_above ema_slow", "macd > 0"],
        "short": ["ema_fast crosses_below ema_slow", "macd < 0"]
      },
      "exit_conditions": {
        "long": ["ema_fast crosses_below ema_slow"],
        "short": ["ema_fast crosses_above ema_slow"]
      },
      "time_filters": {
        "allowed_sessions": [
          {
            "start": "00:00",
            "end": "08:00",
            "timezone": "UTC"
          },
          {
            "start": "08:00",
            "end": "16:00",
            "timezone": "UTC"
          }
        ],
        "blocked_days": ["Saturday", "Sunday"],
        "avoid_around_funding": {
          "enabled": true,
          "minutes_before": 5,
          "minutes_after": 5
        }
      },
      "stop_loss": {
        "type": "atr_fixed",
        "atr_multiplier": 1.5,
        "indicator": "atr"
      },
      "take_profit": {
        "type": "atr_fixed",
        "atr_multiplier": 3.0,
        "indicator": "atr"
      },
      "position_management": {
        "scale_in": {
          "enabled": false
        },
        "partial_exit": {
          "enabled": false
        }
      },
      "sweep": {
        "macd.fast_period": [8, 12, 16],
        "macd.slow_period": [21, 26, 34],
        "ema_fast.period": [5, 9, 13]
      }
    }
  },
